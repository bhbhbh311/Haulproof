# Copy to .env and adjust. All have safe dev defaults if omitted.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
INGEST_API_KEY=change-me-device-key          # driver app sends this as X-Api-Key

# First admin (created by: npm run seed) — the password backup login
ADMIN_EMAIL=admin@callahantrans.com
ADMIN_PASSWORD=changeme123

# --- Microsoft Entra ID (Azure AD) Single Sign-On ---------------------------
# Fill these in from your App Registration (see README "Set up Microsoft sign-in").
# Leave MS_CLIENT_ID / MS_CLIENT_SECRET blank to hide the Microsoft button entirely.
MS_TENANT_ID=your-tenant-guid          # Directory (tenant) ID; or 'organizations' for any work account
MS_CLIENT_ID=                          # Application (client) ID
MS_CLIENT_SECRET=                      # Client secret VALUE (not the secret ID)

# PORTAL_URL is the ONE setting that defines where the portal lives. The Microsoft redirect URI
# is derived from it automatically as  <PORTAL_URL>/api/auth/microsoft/callback  — so when you
# know your real domain, change just this line (and register that same URI in Entra).
PORTAL_URL=http://localhost:4000       # e.g. https://portal.callahantrans.com in production (use https)

# Optional: only set MS_REDIRECT_URI to OVERRIDE the derived one (rare — e.g. a separate auth host).
# MS_REDIRECT_URI=https://portal.callahantrans.com/api/auth/microsoft/callback

# Who may sign in with Microsoft is controlled by sso-allowlist.json (edit anytime).

# Email delivery of consignee copies (optional — logs a simulation if unset)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=documents@callahantrans.com
# SMTP_PASS=app-password
# MAIL_FROM=documents@callahantrans.com
